# Primary AI provider (https://openrouter.ai/keys). If unset, the app runs in
# demo mode and returns a canned sample plan so the UI is fully explorable.
OPENROUTER_API_KEY=

# Model to use through OpenRouter.
LEARNX_MODEL=anthropic/claude-sonnet-4.5

# Live web search for the Analyst agent (company/team research with cited
# sources) via OpenRouter's ":online" plugin. On by default; set to "off" to
# disable (slightly cheaper, research falls back to JD text + model knowledge).
LEARNX_WEB_SEARCH=on

# Used for OpenRouter's HTTP-Referer header.
NEXT_PUBLIC_APP_URL=http://localhost:3000
